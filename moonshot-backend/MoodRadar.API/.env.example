# Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git - use .env.example for reference only

# Ticketmaster Discovery API
# Get your free API key at: https://developer.ticketmaster.com/
# 1. Register for free account
# 2. Create new app -> receive API key
# 3. No credit card required
TICKETMASTER__APIKEY=your_ticketmaster_api_key_here

# PostgreSQL Connection (Phase 2)
DATABASE_URL=postgresql://user:password@localhost:5432/moodradar

# Render.com (Production)
RENDER_API_KEY=your_render_api_key_here

# Environment
ASPNETCORE_ENVIRONMENT=Development
